-- FUNÇÕES PARA ATUALIZAÇÃO AO VIVO
-- ==========================================
local inputs = {} 

local function atualizarGlowAoVivo()
	if not auraAtual or not weldAtual then return end
	
	-- Lê os valores atuais
	local sx = tonumber(inputs["Tam X"].Text) or 10
	local sy = tonumber(inputs["Tam Y"].Text) or 0.1
	local sz = tonumber(inputs["Tam Z"].Text) or 15
	
	local px = tonumber(inputs["Pos X"].Text) or 0
	local py = tonumber(inputs["Pos Y"].Text) or -2
	local pz = tonumber(inputs["Pos Z"].Text) or 0
	
	local rx = tonumber(inputs["Rot X"].Text) or 0
	local ry = tonumber(inputs["Rot Y"].Text) or 0
	local rz = tonumber(inputs["Rot Z"].Text) or 0
	
	local r = tonumber(inputs["Cor R"].Text) or 0
	local g = tonumber(inputs["Cor G"].Text) or 150
	local b = tonumber(inputs["Cor B"].Text) or 255
	
	local brilho = tonumber(inputs["Brilho"].Text) or 15
	local alcance = tonumber(inputs["Alcance"].Text) or 12

	-- Aplica tamanho
	auraAtual.Size = Vector3.new(sx, sy, sz)
	-- Aplica posição e rotação
	weldAtual.C0 = CFrame.new(px, py, pz) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
	
	-- Aplica cor e intensidade da luz
	if luzAtual then
		luzAtual.Color = Color3.fromRGB(r, g, b)
		luzAtual.Brightness = brilho
		luzAtual.Range = alcance
	end
end

local function criarInputComBotoes(nome, valorPadrao, posY, passo)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 60, 0, 30)
	label.Position = UDim2.new(0, 10, 0, posY)
	label.BackgroundTransparency = 1
	label.Text = nome
	label.TextColor3 = Color3.fromRGB(200, 200, 200)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.Parent = Scroll

	local btnMenos = Instance.new("TextButton")
	btnMenos.Size = UDim2.new(0, 30, 0, 30)
	btnMenos.Position = UDim2.new(0, 80, 0, posY)
	btnMenos.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btnMenos.Text = "-"
	btnMenos.TextColor3 = Color3.fromRGB(255, 255, 255)
	btnMenos.Font = Enum.Font.GothamBold
	btnMenos.Parent = Scroll
	Instance.new("UICorner", btnMenos).CornerRadius = UDim.new(0, 4)

	local txtBox = Instance.new("TextBox")
	txtBox.Size = UDim2.new(0, 100, 0, 30)
	txtBox.Position = UDim2.new(0, 115, 0, posY)
	txtBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	txtBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	txtBox.Text = tostring(valorPadrao)
	txtBox.Font = Enum.Font.Gotham
	txtBox.TextSize = 12
	txtBox.Parent = Scroll
	Instance.new("UICorner", txtBox).CornerRadius = UDim.new(0, 4)
	
	inputs[nome] = txtBox

	local btnMais = Instance.new("TextButton")
	btnMais.Size = UDim2.new(0, 30, 0, 30)
	btnMais.Position = UDim2.new(0, 220, 0, posY)
	btnMais.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btnMais.Text = "+"
	btnMais.TextColor3 = Color3.fromRGB(255, 255, 255)
	btnMais.Font = Enum.Font.GothamBold
	btnMais.Parent = Scroll
	Instance.new("UICorner", btnMais).CornerRadius = UDim.new(0, 4)

	-- Lógica de clique (+ e -)
	btnMenos.MouseButton1Click:Connect(function()
		local val = tonumber(txtBox.Text) or valorPadrao
		txtBox.Text = tostring(val - passo)
		atualizarGlowAoVivo()
	end)

	btnMais.MouseButton1Click:Connect(function()
		local val = tonumber(txtBox.Text) or valorPadrao
		txtBox.Text = tostring(val + passo)
		atualizarGlowAoVivo()
	end)

	-- Lógica de escrita direta
	txtBox.FocusLost:Connect(function()
		atualizarGlowAoVivo()
	end)
end

