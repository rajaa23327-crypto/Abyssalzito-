--==========================================
-- HTTP HELPER
--==========================================
local httpReq
do
	httpReq = (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or (request)
end

local function http(method, url, body)
	if not httpReq then return nil end
	local ok, resp = pcall(function()
		return httpReq({
			Url = url, Method = method, Body = body,
			Headers = { ["Content-Type"] = "application/json" },
		})
	end)
	if not ok then return nil end
	return resp
end

local function firebaseDisponivel()
	return CONFIG.FIREBASE_URL ~= ""
		and CONFIG.FIREBASE_URL ~= nil
		and httpReq ~= nil
end

