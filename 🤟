	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		tempoClique = tick()
	end
end)

Bolinha.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if tick() - tempoClique < 0.2 then
			Frame.Visible = true
			Bolinha.Visible = false
		end
