-- ==========================================
-- SISTEMA PARA ARRASTAR (DRAGGABLE)
-- ==========================================
local dragging, dragInput, dragStart, startPos

Titulo.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
Titulo.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ==========================================
-- LÓGICA DE APLICAÇÃO NO CARRO
-- ==========================================
BotaoAplicar.MouseButton1Click:Connect(function()
	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if not humanoid.SeatPart then
		BotaoAplicar.Text = "Senta-te num carro!"
		task.wait(2)
		BotaoAplicar.Text = "Aplicar Imagem & Luz"
		return
	end

	local alvo = humanoid.SeatPart
	local idDaImagem = inputId.Text:match("%d+")

	-- Remove aura antiga
	local velhaAura = alvo:FindFirstChild("UnderglowImagePart")
	if velhaAura then velhaAura:Destroy() end

	-- Cria o Bloco Base
	local auraPart = Instance.new("Part")
	auraPart.Name = "UnderglowImagePart"
	auraPart.Anchored = false
	auraPart.CanCollide = false
	auraPart.Massless = true
	
	-- No começo fica visível para ajudar no posicionamento
	auraPart.Transparency = 0.3 
	auraPart.Color = Color3.fromRGB(255, 255, 255)
	
	-- SurfaceGui para a Imagem
	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "ImagemGui"
	surfaceGui.Face = Enum.NormalId.Top
	surfaceGui.LightInfluence = 1
	surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surfaceGui.PixelsPerStud = 50
	surfaceGui.Parent = auraPart

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Size = UDim2.new(1, 0, 1, 0)
	imageLabel.BackgroundTransparency = 1 
	if idDaImagem then
		imageLabel.Image = "rbxthumb://type=Asset&id=" .. idDaImagem .. "&w=420&h=420"
	end
	imageLabel.Parent = surfaceGui

	-- ===== LUZ SUPER FORTE =====
	local luzGlow = Instance.new("SurfaceLight")
	luzGlow.Name = "LuzUnderglow"
	luzGlow.Face = Enum.NormalId.Bottom -- Emite luz para o chão
	luzGlow.Angle = 120
	luzGlow.Parent = auraPart

	-- Solda a peça no carro
	local weld = Instance.new("Weld")
	weld.Part0 = alvo
	weld.Part1 = auraPart
	weld.Parent = auraPart
	
	auraPart.Parent = alvo
	
	-- Define variáveis globais para a edição ao vivo funcionar
	auraAtual = auraPart
	weldAtual = weld
	luzAtual = luzGlow

	-- Aplica imediatamente os valores que estão na UI (Cor, Brilho, Alcance)
	atualizarGlowAoVivo()
	
	BotaoAplicar.Text = "Aplicado com Sucesso!"
	
	-- Mágica do desaparecimento da caixa física
	task.spawn(function()
		task.wait(3)
		local fade = TweenService:Create(auraPart, TweenInfo.new(1.5), {Transparency = 1})
		fade:Play()
	end)

	task.wait(1.5)
	BotaoAplicar.Text = "Aplicar Imagem & Luz"
end)
