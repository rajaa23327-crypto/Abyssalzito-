-- ==========================================
-- SISTEMA PARA ARRASTAR (DRAGGABLE)
-- ==========================================
local dragging, dragInput, dragStart, startPos

Titulo.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
Titulo.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- ==========================================
-- LÓGICA DA IMAGEM NO CARRO
-- ==========================================
BotaoAplicar.MouseButton1Click:Connect(function()
	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	-- Trava: Precisa estar sentado no carro
	if not humanoid.SeatPart then
		BotaoAplicar.Text = "Sente num carro!"
		task.wait(2)
		BotaoAplicar.Text = "Aplicar Imagem"
		return
	end

	local alvo = humanoid.SeatPart
	local idDaImagem = inputId.Text:match("%d+")

	local sizeX = tonumber(inputX.Text) or 10
	local sizeY = tonumber(inputY.Text) or 0.1
	local sizeZ = tonumber(inputZ.Text) or 15

	local posX = tonumber(inputPosX.Text) or 0
	local posY = tonumber(inputPosY.Text) or -2
	local posZ = tonumber(inputPosZ.Text) or 0
	
	local rotX = tonumber(inputRotX.Text) or 0
	local rotY = tonumber(inputRotY.Text) or 0
	local rotZ = tonumber(inputRotZ.Text) or 0

	-- Remove aura antiga se houver
	local velhaAura = alvo:FindFirstChild("UnderglowImagePart")
	if velhaAura then velhaAura:Destroy() end

	-- Cria o Bloco Base
	local auraPart = Instance.new("Part")
	auraPart.Name = "UnderglowImagePart"
	auraPart.Anchored = false
	auraPart.CanCollide = false
	auraPart.Massless = true
	auraPart.Size = Vector3.new(sizeX, sizeY, sizeZ)
	
	-- No começo o bloco fica visível (com transparência 0.3) para você poder guiar a posição e o tamanho
	auraPart.Transparency = 0.3 
	auraPart.Color = Color3.fromRGB(255, 255, 255)
	
	-- Cria o SurfaceGui para exibir a imagem no topo do bloco
	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "ImagemGui"
	surfaceGui.Face = Enum.NormalId.Top
	surfaceGui.LightInfluence = 1 -- Deixa a imagem receber luz normal do jogo
	surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surfaceGui.PixelsPerStud = 50
	surfaceGui.Parent = auraPart

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Size = UDim2.new(1, 0, 1, 0)
	imageLabel.BackgroundTransparency = 1 
	
	if idDaImagem then
		imageLabel.Image = "rbxthumb://type=Asset&id=" .. idDaImagem .. "&w=420&h=420"
	end
	
	imageLabel.Parent = surfaceGui
	
	-- Solda a parte no carro com os devidos ajustes de Posição e Rotação
	local weld = Instance.new("Weld")
	weld.Part0 = alvo
	weld.Part1 = auraPart
	weld.C0 = CFrame.new(posX, posY, posZ) * CFrame.Angles(math.rad(rotX), math.rad(rotY), math.rad(rotZ))
	
	weld.Parent = auraPart
	auraPart.Parent = alvo
	
	BotaoAplicar.Text = "Aplicado!"
	
	-- ===== MÁGICA: O BLOCO SOME DEPOIS DE 3 SEGUNDOS =====
	task.spawn(function()
		task.wait(3) -- Deixa visível por 3 segundos para você mexer e ajustar o X, Y, Z
		
		-- O bloco fica 100% invisível, mas a imagem continua aparecendo perfeitamente!
		local fade = TweenService:Create(auraPart, TweenInfo.new(1.5), {Transparency = 1})
		fade:Play()
	end)
	-- ====================================================

	task.wait(1.5)
	BotaoAplicar.Text = "Aplicar Imagem"
end)
